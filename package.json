{
  "name": "react_with_webpack",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "homepage": "https://gollorionna.github.io/webpack",
  "type": "module",
  "scripts": {
    "build:dev": "node --loader ts-node/esm ./node_modules/webpack/bin/webpack.js --env mode=development",
    "build:prod": "node --loader ts-node/esm ./node_modules/webpack/bin/webpack.js --env mode=production",
    "build:mobile": "webpack --env mode=production --env platform=mobile",
    "build:desktop": "webpack --env mode=production --env platform=desktop",
    "predeploy": "npm run build:dev",
    "deploy": "gh-pages -d build",
    "typecheck": "tsc",
    "node": "node build/main.js",
    "start": "node --loader ts-node/esm ./node_modules/webpack/bin/webpack.js serve --env mode=development"
  },
